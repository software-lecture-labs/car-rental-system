# Bu dosyayı .env.local adıyla kopyala:  cp .env.example .env.local
# Spring Boot backend'inin adresi. Tarayıcı backend'e doğrudan gitmez;
# istekler Next sunucusundan (route handler) bu adrese iletilir.
BACKEND_URL=http://localhost:8080

# Oturum cookie'si Secure işaretli olsun mu? Boş bırakılırsa istek HTTPS ise otomatik açılır.
# Sadece HTTPS arkasında çalışırken "true" yap.
# COOKIE_SECURE=true
